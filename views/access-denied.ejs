<%- include('partials/header') %>
  <h1 class="h3 mb-3"><%= title %></h1>
  <div class="alert alert-danger border-0 shadow-sm" role="alert">
    <p class="mb-2"><strong>Кто пытался:</strong> <%= actor %></p>
    <p class="mb-2"><strong>Что пытались сделать:</strong> <%= attemptedAction %></p>
    <p class="mb-0"><strong>Почему система отказала:</strong> <%= reason %></p>
  </div>
  <div class="d-flex flex-wrap gap-2">
    <a class="btn btn-clinic" href="/">На главную</a>
    <a class="btn btn-outline-secondary" href="/appointments">К списку записей</a>
    <a class="btn btn-outline-success" href="/appointments/new">Создать запись правильно</a>
  </div>
<%- include('partials/footer') %>
