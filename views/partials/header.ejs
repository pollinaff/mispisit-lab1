          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/notifications' ? 'active' : '' %>" href="/notifications">Уведомления</a>
          </li>
          <li class="nav-item">
            <a class="nav-link <%= currentPath === '/access-denied' ? 'active' : '' %>" href="/access-denied">Пример отказа</a>
