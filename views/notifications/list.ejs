<%- include('../partials/header') %>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Уведомления</h1>
    <a class="btn btn-outline-secondary btn-sm" href="/appointments">К записям</a>
  </div>

  <p class="text-secondary">Сообщения о событиях системы после действий пользователя. Каждое уведомление связано с конкретной записью в базе.</p>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-4">
      <% if (items.length === 0) { %>
        <div class="empty-state text-center py-5 px-3">
          <h2 class="h5 mb-2">Уведомлений пока нет</h2>
          <p class="text-secondary mb-4">После создания записи на приём здесь появится сообщение с номером записи.</p>
          <a class="btn btn-clinic" href="/appointments/new">Создать запись</a>
        </div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>№</th>
                <th>Событие</th>
                <th>Запись</th>
                <th>Статус</th>
                <th>Когда</th>
              </tr>
            </thead>
            <tbody>
              <% items.forEach(function(item) { %>
                <tr>
                  <td><%= item.id %></td>
                  <td><%= item.message %></td>
                  <td><a href="/appointments/<%= item.appointmentId %>"><%= item.recordLabel %></a></td>
                  <td><span class="badge rounded-pill status-badge"><%= item.status %></span></td>
                  <td><%= new Date(item.createdAt).toLocaleString('ru-RU') %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
<%- include('../partials/footer') %>
